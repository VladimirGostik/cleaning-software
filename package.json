{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint:js": "eslint resources/js vite.config.js",
        "fix:js": "eslint --fix resources/js vite.config.js",
        "lint:prettier": "prettier --check 'resources/**/*.{ts,vue,css,json}'",
        "fix:prettier": "prettier --write 'resources/**/*.{ts,vue,css,json}'",
        "lint": "pnpm run lint:js && pnpm run lint:prettier && pnpm run typecheck",
        "fix": "pnpm run fix:js && pnpm run fix:prettier"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@heroicons/vue": "^2.2.0",
        "@playwright/test": "^1.61.0",
        "@tailwindcss/vite": "^4.0.0",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^9.0.1",
        "daisyui": "^5.5.19",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.0",
        "laravel-vite-plugin": "^1.3.0",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^7.3.2",
        "vue-tsc": "^3.2.7"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.21",
        "@fullcalendar/daygrid": "^6.1.21",
        "@fullcalendar/interaction": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.21",
        "@fullcalendar/vue3": "^6.1.21",
        "@inertiajs/vue3": "^3.0.3",
        "axios": "^1.16.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.33"
    }
}
